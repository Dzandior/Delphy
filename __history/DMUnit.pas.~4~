  mciSendString(PChar(Cmd), nil, 0, 0);
end;

procedure TDM.PlayMusic;
begin
  // ... ваш код
end;

procedure TDM.StopMusic;
begin
  // ... ваш код
end;

procedure TDM.PlayClickSound;
var
  Path: string;
begin
  Path := IncludeTrailingPathDelimiter(
            ExtractFilePath(ParamStr(0))
          ) + ClickSoundFile;
  if FileExists(Path) then
    PlaySound(PChar(Path), 0, SND_ASYNC or SND_FILENAME);
end;

end.








procedure TDM.PlayMusic;
var
  Path: string;
begin
  // Если уже играет — выходим, не перезапуская
  if FIsPlaying then
    Exit;

  Path := IncludeTrailingPathDelimiter(ExtractFilePath(ParamStr(0))) +
          'resources\music\background.mp3';
  if not FileExists(Path) then
    Exit;  // или выдайте ошибку

  // Открываем и запускаем в цикл
  SendCmd('open "' + Path + '" alias bgMusic');
  SendCmd('play bgMusic repeat');

  FIsPlaying := True;
end;

procedure TDM.StopMusic;
begin
  if not FIsPlaying then
    Exit;

  SendCmd('stop bgMusic');
  SendCmd('close bgMusic');
  FIsPlaying := False;
end;
