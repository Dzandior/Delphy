unit MainMenuUnit;

interface

uses
  System.SysUtils, System.Classes, Vcl.Forms, Vcl.Controls, Vcl.ExtCtrls, JPEG,
  DMUnit, GameMenuUnit, SettingsUnit, CreditsUnit,
  CustomImageButton, SettingsManagerUnit, Vcl.ImgList, System.ImageList,LngStrings;

type
  TMainMenuForm = class(TForm)
    ImageBackground: TImage;
    ButtonPlay: TCustomImageButton;
    ButtonSettings: TCustomImageButton;
    ButtonCredits: TCustomImageButton;
    ButtonExit: TCustomImageButton;
    ImageList1: TImageList;
    procedure FormCreate(Sender: TObject);
    procedure FormShow(Sender: TObject);
    procedure ButtonPlayClick(Sender: TObject);
    procedure ButtonSettingsClick(Sender: TObject);
    procedure ButtonCreditsClick(Sender: TObject);
    procedure ButtonExitClick(Sender: TObject);
  public
    GameSettings: TGameSettings;
    SettingsFilePath: string;
    procedure ApplyCaptions;
    procedure ApplyDisplayMode(Mode: TDisplayMode);
  end;

var
  MainMenuForm: TMainMenuForm;

implementation

{$R *.dfm}

procedure TMainMenuForm.FormCreate(Sender: TObject);
begin
  DoubleBuffered := True;
  BorderStyle := bsNone;

  SettingsFilePath := IncludeTrailingPathDelimiter(
    ExtractFilePath(ParamStr(0))
  ) + 'settings.ini';

  LoadSettings(GameSettings, SettingsFilePath);
  ApplyDisplayMode(GameSettings.DisplayMode);

  WindowState := wsMaximized;
  ImageBackground.Picture.LoadFromFile(
    ExtractFilePath(ParamStr(0)) + 'resources\images\background\1.jpg'
  );
  ImageBackground.SendToBack;
end;

procedure TMainMenuForm.ApplyCaptions;
begin
  ButtonPlay.Caption     := rsPlay;
  ButtonSettings.Caption := rsSettings;
  ButtonCredits.Caption  := rsCredits;
  ButtonExit.Caption     := rsExit;
end;

procedure TMainMenuForm.FormShow(Sender: TObject);
begin
  DM.FMusicVolume   := GameSettings.MusicVolume;
  DM.FEffectsVolume := GameSettings.EffectsVolume;
  DM.FMasterVolume  := GameSettings.MasterVolume;
  DM.EnableClickSound(GameSettings.ClickSoundEnabled);
  DM.PlayMusic;
end;

procedure TMainMenuForm.ButtonPlayClick(Sender: TObject);
begin
  DM.PlayClickSound;
  DM.StopMusic;
  Hide;
  if not Assigned(GameMenuForm) then
    GameMenuForm := TGameMenuForm.Create(Application);
  GameMenuForm.Show;
end;

procedure TMainMenuForm.ButtonSettingsClick(Sender: TObject);
begin
  DM.PlayClickSound;
  Hide;
  if not Assigned(SettingsForm) then
    SettingsForm := TSettingsForm.Create(Application);
  SettingsForm.Show;
end;

procedure TMainMenuForm.ButtonCreditsClick(Sender: TObject);
begin
  DM.PlayClickSound;
  Hide;
  if not Assigned(CreditsForm) then
    CreditsForm := TCreditsForm.Create(Application);
  CreditsForm.Show;
end;

procedure TMainMenuForm.ButtonExitClick(Sender: TObject);
begin
  DM.PlayClickSound;
  DM.StopMusic;
  Application.Terminate;
end;

procedure TMainMenuForm.ApplyDisplayMode(Mode: TDisplayMode);
var
  SW, SH: Integer;
begin
  SW := Screen.Width;      // ширина экрана пользователя :contentReference[oaicite:3]{index=3}
  SH := Screen.Height;     // высота экрана пользователя :contentReference[oaicite:4]{index=4}

  case Mode of
    dmFullscreen:
      begin
        BorderStyle := bsNone;
        WindowState := wsMaximized;  // В полноэкранном режиме Delphi автоматически растянет форму :contentReference[oaicite:5]{index=5}
      end;

    dmBorderless:
      begin
        BorderStyle := bsNone;
        WindowState := wsNormal;
        // Размещаем и растягиваем форму на весь экран вручную
        SetBounds(0, 0, SW, SH);      // задаёт Left=0, Top=0, Width=SW, Height=SH :contentReference[oaicite:6]{index=6}
      end;

    dmWindowed:
      begin
        BorderStyle := bsSizeable;
        WindowState := wsNormal;
        // Формально тоже растягиваем на весь экран, но с рамкой
        SetBounds(0, 0, SW, SH);      // можно также оставить смещённым или задать конкретный размер :contentReference[oaicite:7]{index=7}
      end;
  end;

end;


end.
